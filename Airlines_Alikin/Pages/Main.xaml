<Page x:Class="Airlines_Alikin.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Airlines_Alikin.Pages"
      mc:Ignorable="d" 
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      d:DesignHeight="450" d:DesignWidth="500"
      Title="Main">

    <Grid Background="#FF0C73FE">
        <Label VerticalAlignment="Top" HorizontalAlignment="Center" Content="Поиск дешевых авиабилетов" Margin="0,51,0,0" Foreground="White" FontSize="20" FontWeight="Bold" />
        <Label VerticalAlignment="Top" HorizontalAlignment="Center"  Content="Лучший способ купить авиабилеты дёшево" Margin="0,88,0,0" Foreground="White" />
        <StackPanel Width="298" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,119,0,0">
            <Label Content="Откуда" HorizontalAlignment="Left" Foreground="White" />
            <TextBox x:Name="from" Height="25" Margin="0,2,0,0" />
            <Label Content="Куда" HorizontalAlignment="Left" Foreground="White" Margin="0,8,0,0" />
            <TextBox x:Name="to" Height="25" Margin="0,2,0,0" />
            <Label Content="Дата вылета " HorizontalAlignment="Left" Foreground="White" Margin="0,8,0,0" />
            <DatePicker x:Name="date" Height="25" Margin="0,2,0,0" SelectedDate="{x:Static sys:DateTime.Today}" DisplayDateStart="{x:Static sys:DateTime.Today}"/>
            <Button Content="Найти" Click="Search" HorizontalAlignment="Right"  Width="100" Height="25" Margin="0,8,0,0"  Background="#FFFF3A00" Foreground="White" />
        </StackPanel>
    </Grid>
</Page>
